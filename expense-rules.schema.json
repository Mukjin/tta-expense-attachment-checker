{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tta.example.invalid/schema/expense-rules.schema.json",
  "title": "지출결의 첨부 규칙",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "ruleset", "expense_types"],
  "properties": {
    "$schema": { "type": "string" },
    "schema_version": { "const": "1.0" },
    "ruleset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "effective_from": { "type": ["string", "null"], "format": "date" },
        "approved_by": { "type": ["string", "null"] }
      }
    },
    "expense_types": {
      "type": "array",
      "items": { "$ref": "#/$defs/expenseType" }
    }
  },
  "$defs": {
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["field"],
          "properties": {
            "field": { "type": "string", "minLength": 1 },
            "operator": { "enum": ["eq", "ne", "gt", "gte", "lt", "lte", "in", "contains", "matches", "exists"] },
            "value": {}
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["all"],
          "properties": { "all": { "type": "array", "items": { "$ref": "#/$defs/condition" }, "minItems": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["any"],
          "properties": { "any": { "type": "array", "items": { "$ref": "#/$defs/condition" }, "minItems": 1 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["not"],
          "properties": { "not": { "$ref": "#/$defs/condition" } }
        }
      ]
    },
    "attachmentMatch": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "system_type_codes": { "type": "array", "items": { "type": "string" } },
        "filename_patterns": { "type": "array", "items": { "type": "string" } },
        "extensions": { "type": "array", "items": { "type": "string" } },
        "mime_types": { "type": "array", "items": { "type": "string" } }
      },
      "anyOf": [
        { "required": ["system_type_codes"] },
        { "required": ["filename_patterns"] }
      ]
    },
    "requirement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "match"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["warn", "block"] },
        "reason": { "type": "string" },
        "obtain_from": { "type": "string" },
        "when": { "$ref": "#/$defs/condition" },
        "match": { "$ref": "#/$defs/attachmentMatch" },
        "alternatives": {
          "type": "object",
          "additionalProperties": false,
          "required": ["any_of"],
          "properties": { "any_of": { "type": "array", "items": { "type": "string" }, "minItems": 1 } }
        }
      }
    },
    "expenseType": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "name", "match", "required_attachments"],
      "properties": {
        "code": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "match": { "$ref": "#/$defs/condition" },
        "required_attachments": { "type": "array", "items": { "$ref": "#/$defs/requirement" } }
      }
    }
  }
}
