{
  "$schema": "../expense-rules.schema.json",
  "schema_version": "1.0",
  "ruleset": {
    "id": "poc-virtual-expense-rules",
    "version": "0.1.0-poc",
    "effective_from": null,
    "approved_by": "PoC 가상규칙 — 운영 사용 금지"
  },
  "expense_types": [
    {
      "code": "POC_PURCHASE",
      "name": "가상 물품구매 PoC",
      "match": {
        "field": "page.title",
        "operator": "contains",
        "value": "지출"
      },
      "required_attachments": [
        {
          "id": "estimate",
          "name": "견적서",
          "severity": "block",
          "reason": "구매금액과 공급 조건을 사전에 확인하기 위한 가상 PoC 규칙임.",
          "obtain_from": "구매 담당자 또는 공급업체",
          "match": {
            "filename_patterns": ["견적서|견적"],
            "extensions": ["pdf", "hwp", "hwpx", "docx"]
          }
        },
        {
          "id": "statement",
          "name": "거래명세서",
          "severity": "warn",
          "reason": "구매 품목과 수량 확인을 위한 가상 PoC 규칙임.",
          "obtain_from": "공급업체",
          "match": {
            "filename_patterns": ["거래명세서|거래명세"],
            "extensions": ["pdf", "hwp", "hwpx", "xls", "xlsx", "docx"]
          }
        },
        {
          "id": "tax_invoice",
          "name": "세금계산서",
          "severity": "block",
          "reason": "공급가액과 부가세 확인을 위한 가상 PoC 규칙임.",
          "obtain_from": "전자세금계산서 발급 시스템 또는 공급업체",
          "match": {
            "filename_patterns": ["세금계산서|전자세금계산서"],
            "extensions": ["pdf", "hwp", "hwpx", "xls", "xlsx", "docx"]
          }
        }
      ]
    }
  ]
}

