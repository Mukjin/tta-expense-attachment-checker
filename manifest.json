{
  "manifest_version": 3,
  "name": "전자문서 AI · 지출 첨부검사",
  "version": "0.5.0",
  "key": "",
  "description": "전자문서 요약·검토와 지출결의 필수 첨부 및 파일 내부 내용을 로컬에서 사전 검사합니다.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "전자문서 AI · 지출 첨부검사"
  },
  "options_page": "options.html",
  "background": { "service_worker": "background.js", "type": "module" },
  "permissions": ["activeTab", "scripting", "storage", "contextMenus"],
  "optional_host_permissions": ["*://*/*"],
  "host_permissions": [
    "https://gw.tta.or.kr/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [{
    "matches": ["https://gw.tta.or.kr/*"],
    "js": ["widget.js"],
    "run_at": "document_idle"
  }]
}
